# LocationInsights (ipinfo.io)
# VITE_IPINFO_TOKEN=

# Vite app → Sanity Content API (public reads; no token needed for public datasets)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Optional override (default 2024-01-01 in code)
# VITE_SANITY_API_VERSION=2024-01-01

# Only if the dataset is not public
# VITE_SANITY_READ_TOKEN=

# Contact form (Vercel serverless: api/contact.ts — never use VITE_ prefix)
# Gmail often blocks SMTP from cloud hosts (e.g. Vercel). If it fails, use custom SMTP (e.g. Brevo free tier).
#
# Default: Gmail app password (2FA → App passwords), not your normal login password
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# Optional inbox; defaults to SMTP_USER
# CONTACT_TO_EMAIL=you@gmail.com
#
# Optional: Brevo / SendGrid / etc. (see README)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
#
# Temporary: set SMTP_DEBUG=1 on Vercel to return SMTP error text in JSON (remove after debugging)
# SMTP_DEBUG=1
