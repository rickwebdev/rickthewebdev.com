# LocationInsights (ipinfo.io)
# VITE_IPINFO_TOKEN=

# Vite app → Sanity Content API (public reads; no token needed for public datasets)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Optional override (default 2024-01-01 in code)
# VITE_SANITY_API_VERSION=2024-01-01

# Only if the dataset is not public
# VITE_SANITY_READ_TOKEN=

# Contact form (Vercel serverless: api/contact.ts — never use VITE_ prefix)
# Gmail: use an App Password (Google Account → Security → 2FA → App passwords), not your normal password
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# Optional; defaults to SMTP_USER if omitted
# CONTACT_TO_EMAIL=you@gmail.com
