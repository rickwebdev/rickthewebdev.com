# Copy this file to: sanity/.env  (Studio does not read .env from the repo root)
# Project ID: https://www.sanity.io/manage → your project
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Migration only: npm run migrate — create at https://www.sanity.io/manage → API → Tokens (Editor)
# SANITY_API_WRITE_TOKEN=

# Optional: custom hostname when using sanity deploy
# SANITY_STUDIO_STUDIO_HOST=
